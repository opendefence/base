{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["issuer"],
  "properties": {
    "issuer": {
      "type": "object",
      "required": ["type", "acme", "ca"],
      "properties": {
        "type": { "type": "string", "enum": ["acme", "ca"] },
        "acme": {
          "type": "object",
          "properties": {
            "email": { "type": "string" },
            "server": { "type": "string", "minLength": 1 }
          },
          "required": ["server"]
        },
        "ca": {
          "type": "object",
          "properties": {
            "commonName": { "type": "string", "minLength": 1 }
          },
          "required": ["commonName"]
        }
      }
    }
  },
  "if": {
    "properties": {
      "issuer": { "properties": { "type": { "const": "acme" } } }
    }
  },
  "then": {
    "properties": {
      "issuer": {
        "properties": {
          "acme": {
            "required": ["email"],
            "properties": {
              "email": {
                "type": "string",
                "minLength": 1,
                "format": "email"
              }
            }
          }
        }
      }
    }
  }
}
